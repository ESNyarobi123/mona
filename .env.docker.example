# Copy to .env on server: cp .env.docker.example .env

# ===== Server =====
PUBLIC_IP=178.104.240.204
# Domain A-record → PUBLIC_IP, then Let's Encrypt via scripts/init-ssl.sh
APP_DOMAIN=monanafood.co.tz
SSL_EMAIL=admin@monanafood.co.tz

# ===== Postgres =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=monana
# Demo catalog + demo orders. Set true ONLY on a brand-new empty database —
# the seed wipes catalog and orders before inserting demo data.
RUN_SEED=false

# ===== Auth =====
AUTH_SECRET=change-me-auth-secret-min-32-chars
JWT_SECRET=change-me-jwt-secret-min-32-chars

# ===== Public URLs =====
NEXT_PUBLIC_APP_URL=https://monanafood.co.tz
API_BASE_URL=http://web:3000/api

# ===== WhatsApp =====
ADMIN_WHATSAPP_NUMBER=255750599412
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Shared secret between the web API and the WhatsApp bot bridge.
# Generate with: openssl rand -hex 32
BOT_SHARED_SECRET=change-me-bot-shared-secret

# ===== Payments =====
LIPA_NAMBA=XXXXXXX
LIPA_NAMBA_NAME=MONANA
CRON_SECRET=change-me-cron-secret
